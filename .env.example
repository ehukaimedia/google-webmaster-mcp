# Google OAuth credentials for google-webmaster-mcp-auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PROFILE=default

# Project context for CLI and MCP runs.
GTM_ID=GTM-XXXXXXX
GSC_SITE=sc-domain:example.com
GA4_PROPERTY_ID=123456789
GA4_MID=G-XXXXXXXXXX
GTM_WORKSPACE_ID=

# Optional Google Business Profile. Off unless explicitly enabled after Google
# approves GBP API access (quota 300 QPM). Do not set true while quota is 0.
GBP_ENABLED=false
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# Optional PageSpeed Insights API key for seo-audit --pagespeed.
GOOGLE_WEBMASTER_MCP_API_KEY=
