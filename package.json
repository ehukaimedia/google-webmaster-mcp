{
  "name": "google-webmaster-mcp",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "google-webmaster-mcp": "./dist/index.js",
    "google-webmaster-mcp-auth": "./dist/auth/cli.js",
    "google-webmaster-audit": "./scripts/audit.js",
    "google-webmaster-submit-sitemap": "./scripts/submit_sitemap.js",
    "google-webmaster-gtm-validate": "./scripts/validate_gtm.js",
    "google-webmaster-gtm-publish": "./scripts/publish_gtm.js",
    "google-webmaster-setup-ga4": "./scripts/setup_ga4_tags.js",
    "seo-audit": "./scripts/audit-cli.mjs",
    "seo-audit-smart": "./scripts/smart-audit.mjs"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "auth": "node dist/auth/cli.js",
    "audit": "node scripts/audit.js",
    "audit:deps": "npm audit --audit-level=high",
    "check": "npm test && npm run audit:deps",
    "sitemap": "node scripts/submit_sitemap.js",
    "validate": "node scripts/validate_gtm.js",
    "publish": "node scripts/publish_gtm.js",
    "setup-ga4": "node scripts/setup_ga4_tags.js",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.18.0",
    "axios": "1.15.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "5.7.1",
    "google-auth-library": "10.6.2",
    "googleapis": "^166.0.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ts-node": "^10.9.2"
  }
}
